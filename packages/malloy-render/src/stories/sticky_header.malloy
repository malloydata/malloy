source: products is duckdb.table("static/data/products.parquet") extend {
  view: long_table is {
    group_by: brand
    aggregate:
      product_count is count()
      avg_retail is retail_price.avg()
    order_by: product_count desc
    limit: 200
  }

  # dashboard
  view: dashboard_rows is {
    group_by: department
    aggregate: product_count is count()
    nest: top_brands is {
      group_by: brand
      aggregate: n is count()
      limit: 8
    }
    # bar_chart
    nest: by_category is {
      group_by: category
      aggregate: n is count()
      limit: 8
    }
  }
}
