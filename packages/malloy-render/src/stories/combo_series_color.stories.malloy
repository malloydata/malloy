// # color on a measure sets that series' color in a combo chart; other
// measures keep their palette color.

source: products is duckdb.table("static/data/products.parquet") extend {
  measure:
    product_count is count()
    avg_retail is retail_price.avg()
    total_retail is retail_price.sum()
    avg_cost is cost.avg()

  #(story) story="Default colors"
  # combo_chart
  view: combo_default is {
    group_by: category
    aggregate: total_retail, avg_retail
    limit: 10
  }

  #(story) story="Color on the line measure"
  # combo_chart
  view: combo_colored_line is {
    group_by: category
    aggregate:
      total_retail
      # color='#E45756'
      avg_retail
    limit: 10
  }

  #(story) story="Color on both measures"
  # combo_chart
  view: combo_colored_both is {
    group_by: category
    aggregate:
      # color='#54A24B'
      total_retail
      # color='#F58518'
      avg_retail
    limit: 10
  }
}
