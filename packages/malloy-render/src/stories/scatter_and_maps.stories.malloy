// Scatter and map charts are drawn live, with Malloy's tooltip on hover;
// a scatter with no color field takes the theme's first color.

source: products is duckdb.table("static/data/products.parquet") extend {
  measure:
    product_count is count()
    avg_retail is retail_price.avg()
    total_retail is retail_price.sum()
    avg_cost is cost.avg()

  #(story) story="Scatter, no color field"
  # scatter_chart
  view: scatter_no_color is {
    group_by: price is floor(retail_price)
    aggregate: avg_cost
    limit: 150
  }

  #(story) story="Scatter, color field"
  # scatter_chart
  view: scatter_color is {
    group_by: price is floor(retail_price)
    aggregate: avg_cost
    group_by: department
    limit: 150
  }
}

source: state_sales is duckdb.sql("""
  SELECT * FROM (VALUES
    ('California', 39538, 34.05, -118.24, 37.77, -122.42),
    ('Texas', 29145, 29.76, -95.37, 32.78, -96.80),
    ('Florida', 21538, 25.76, -80.19, 28.54, -81.38),
    ('New York', 20201, 40.71, -74.00, 42.36, -71.06),
    ('Illinois', 12812, 41.88, -87.63, 39.10, -94.58),
    ('Washington', 7614, 47.61, -122.33, 45.52, -122.68)
  ) AS t(state, sales, lat1, lon1, lat2, lon2)
""") extend {
  #(story) story="Shape map"
  # shape_map
  view: shape_map is {
    group_by: state
    aggregate: total_sales is sales.sum()
  }

  #(story) story="Segment map"
  # segment_map
  view: segment_map is {
    group_by: lat1, lon1, lat2, lon2
  }
}
