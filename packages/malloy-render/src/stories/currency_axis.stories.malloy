// A # currency measure with no scale of its own is shortened on chart
// axes ($1.4M); tables and tooltips keep the full value.

source: products is duckdb.table("static/data/products.parquet") extend {
  measure:
    product_count is count()
    avg_retail is retail_price.avg()
    total_retail is retail_price.sum()
    avg_cost is cost.avg()

  #(story) story="Currency bar chart axis"
  # bar_chart
  view: currency_axis is {
    group_by: category
    aggregate:
      # currency
      total_retail
    limit: 12
  }

  #(story) story="Negative currency axis"
  # bar_chart
  view: currency_negative_axis is {
    group_by: category
    aggregate:
      # currency
      margin_vs_target is sum(retail_price - cost * 2.2)
    limit: 10
  }

  #(story) story="Currency line chart axis"
  # line_chart
  view: currency_line_axis is {
    group_by: department, category
    aggregate:
      # currency
      total_retail
    limit: 20
  }
}
