{
  "name": "@malloydata/db-bigquery",
  "version": "0.0.436",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "homepage": "https://github.com/malloydata/malloy#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/malloydata/malloy"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint '**/*.ts{,x}'",
    "lint-fix": "eslint '**/*.ts{,x}' --fix",
    "test": "cd ../.. && ts-node scripts/check_dialect_connection.ts bigquery && jest packages/malloy-db-bigquery",
    "build": "tsc --build",
    "dev": "tsc --build",
    "clean": "tsc --build --clean && rm -f tsconfig.tsbuildinfo",
    "malloyc": "ts-node ../../scripts/malloy-to-json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@google-cloud/bigquery": "7.9.4",
    "@google-cloud/common": "5.0.2",
    "@google-cloud/paginator": "5.0.2",
    "@malloydata/malloy": "0.0.436",
    "gaxios": "^4.2.0"
  }
}
