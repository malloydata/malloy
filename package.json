{
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "name": "malloy",
  "workspaces": {
    "packages": [
      "packages/malloy-interfaces",
      "packages/malloy-tag",
      "packages/malloy-filter",
      "packages/malloy-query-builder",
      "packages/malloy",
      "packages/malloy-db-bigquery",
      "packages/malloy-db-trino",
      "packages/malloy-db-duckdb",
      "packages/malloy-db-mysql",
      "packages/malloy-db-databricks",
      "packages/malloy-db-postgres",
      "packages/malloy-db-snowflake",
      "packages/malloy-db-sqlserver",
      "packages/malloy-db-publisher",
      "packages/malloy-connections",
      "packages/malloy-malloy-sql",
      "packages/malloy-render",
      "packages/malloy-render-validator",
      "packages/malloy-syntax-highlight",
      "test",
      "profiler"
    ]
  },
  "files": [
    "samples"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=9"
  },
  "scripts": {
    "clean": "npm run -ws clean && rm -f tsconfig.tsbuildinfo",
    "codegen": "npm run -w packages/malloy -w packages/malloy-filter -w packages/malloy-malloy-sql codegen",
    "dev": "npm run -ws --if-present dev",
    "build": "npm run -ws build",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "test": "ts-node scripts/jest_select.ts test",
    "dbtest": "ts-node scripts/jest_select.ts dbtest",
    "typecheck": "tsc --build test/tsconfig.json",
    "precheck": "npm run typecheck && MALLOY_DATABASE=duckdb npm test -- --reporters agent",
    "ci-core": "jest --selectProjects core malloy-render-test malloy-render --reporters agent",
    "third-party-licenses": "ts-node scripts/third_party_licenses",
    "malloyc": "ts-node scripts/malloy-to-json",
    "test-consumer-canary": "npm run build && npm run consumer-canary",
    "consumer-canary": "npm run consumer-canary:bundle && npm run consumer-canary:jest",
    "consumer-canary:bundle": "node test/consumer-canary/bundle-check.mjs",
    "consumer-canary:jest": "jest --config test/consumer-canary/jest.config.ts",
    "build-duckdb-db": "sh test/duckdb/load_test_data.sh",
    "setup-new-checkout": "scripts/setup-new-checkout.sh"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.14",
    "@jest/globals": "^30.5.2",
    "@malloydata/db-bigquery": "*",
    "@malloydata/db-mysql": "*",
    "@malloydata/malloy": "*",
    "@malloydata/motly-ts-parser": "^0.9.1",
    "@malloydata/render": "*",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/yargs": "^17.0.33",
    "axios": "1.19.0",
    "babel-jest": "^30.5.2",
    "cross-os": "^1.5.0",
    "csv-stringify": "^6.9.0",
    "dotenv-cli": "^11.1.0",
    "flow-api-translator": "^0.341.0",
    "fs-extra": "^11.4.1",
    "gts": "^7.0.0",
    "jest": "^30.5.2",
    "jest-diff": "^30.4.1",
    "jest-environment-jsdom": "^30.5.2",
    "jest-expect-message": "^1.1.3",
    "jest-util": "^30.5.1",
    "lerna": "^10.1.3",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.1",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "uuid": "^11.1.1",
    "yargs": "^18.0.0"
  },
  "dependencies": {},
  "overrides": {
    "typescript": "^6.0.3",
    "lodash": "^4.18.1"
  }
}
